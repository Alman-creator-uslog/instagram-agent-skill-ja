  "structures": [
    {
      "id": "not-just",
      "regex": "(?:だけ|のみ)(?:で)?(?:なく|はなく)[、,]?[^。！？\\n]{1,40}(?:も|まで)|単なる[^。！？\\n]{1,30}(?:ではなく|じゃなく)",
      "name": "「〜だけでなく、〜も」「単なる〜ではなく」",
      "fix": "本当に言いたい1つを言う。前置きの半分は消す。"
    },
    {
      "id": "isnt-about",
      "regex": "(?:大切|重要|大事|本質)なのは[^。！？\\n]{1,40}(?:ではなく|じゃなく)",
      "name": "「大切なのは〜ではなく〜」",
      "fix": "後半から始める。ひっくり返す形そのものがAIのくせ。"
    },
    {
      "id": "the-result",
      "regex": "(?m)^\\s*(?:その)?(?:結果|答え|理由|結論|正解|ポイント|秘密)は[？?]\\s*$",
      "name": "1行だけの問いかけ（「その結果は？」）",
      "fix": "もったいぶらず、その場で答える。"
    },
    {
      "id": "heres-what",
      "regex": "(?:わかった|学んだ|気づいた)こと(?:を|は)[^。\\n]{0,10}(?:紹介|まとめ|シェア|お伝え)",
      "name": "「学んだことをシェアします」",
      "fix": "学んだことを言う。予告はいらない。"
    },
    {
      "id": "triad",
      "regex": "[^、。！？\\n]{1,15}、[^、。！？\\n]{1,15}、そして[^、。！？\\n]{1,15}|(?:ポイント|コツ|理由|方法|メリット)は(?:3|三|３)つ",
      "name": "3つ並べ（「A、B、そしてC」「ポイントは3つ」）",
      "fix": "2つか4つにする。3つはAIの初期設定のリズム。"
    },
    {
      "id": "rocket",
      "regex": "[🚀🔥💡✨🎯]",
      "name": "🚀🔥💡✨🎯 の絵文字",
      "fix": "絵文字は1つまで。この5つ以外で。"
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:[#＃][^\\s#＃]+[ \\t　]*){5,}",
      "name": "ハッシュタグの壁（5個以上を連ねる）",
      "fix": "3個くらいに絞る。上限は5個。"
    },
    {
      "id": "as-an-ai",
      "regex": "(?:AI|言語モデル|人工知能)(?:として|なので|である私)",
      "name": "AIが自分のことを言う",
      "fix": "その文を消す。"
    },
    {
      "id": "in-summary",
      "regex": "(?m)^\\s*(?:まとめると|要するに|結論として|総じて|以上のように|いかがでしたか)",
      "name": "作文の締めの出だし（「まとめると」）",
      "fix": "投稿に結論の段落はいらない。"
    },
    {
